menu "ESPD Configuration"

choice ESPD_BOARD
    prompt "Target board"
    default ESPD_BOARD_GENERIC
    help
        Select the hardware board. Board-specific options are registered by BSP
        components (see menuconfig after selecting a board). Each board may imply
        an ESPD feature profile and ship sdkconfig.defaults for IDF tuning.

config ESPD_BOARD_GENERIC
    bool "Generic I2S (manual GPIO pins)"
    imply ESPD_ENABLE_LEGACY_WIFI_TRANSPORT
    help
        Bare I2S pins without an external codec driver. Tune GPIOs under
        "Generic board I2S pins" below. Additional boards are added by BSP
        components (e.g. bsp_waveshare_s3 in this repository).

endchoice

config ESPD_BSP_COMPONENT_NAME
    string "BSP component to link"
    default ""
    help
        Set automatically by the selected board (each BSP registers its
        component name). Override at configure time with -DESPD_BSP_COMPONENT=...

config ESPD_IOCHANS
    int "Audio I/O channels (dac~ / adc~)"
    default 2
    range 1 2

config ESPD_USE_ADC
    bool "Enable audio input (adc~)"
    default n
    help
        When enabled, espd_audio reads from the board microphone / ADC path.

choice ESPD_AUDIO_BACKEND
    prompt "Audio backend"
    default ESPD_AUDIO_BACKEND_GENERIC_I2S if ESPD_BOARD_GENERIC
    default ESPD_AUDIO_BACKEND_BSP_CODEC if ESPD_BOARD_WAVESHARE_S3
    help
        Generic I2S drives pins directly. BSP codec uses bsp_audio_* from the
        active BSP package (see bsp/config.h in the linked BSP component).

config ESPD_AUDIO_BACKEND_GENERIC_I2S
    bool "Generic I2S (no codec driver)"
    depends on ESPD_BOARD_GENERIC

config ESPD_AUDIO_BACKEND_BSP_CODEC
    bool "BSP codec (esp_codec_dev via bsp_audio_*)"
    depends on !ESPD_BOARD_GENERIC

endchoice

config ESPD_PD_USE_WIFI
    bool "Enable WiFi for Pd net objects"
    default y

config ESPD_PD_USE_CONSOLE
    bool "Enable USB serial console for Pd messages"
    default y

config ESPD_PD_USE_SDCARD
    bool "Enable SD card support"
    default n

config ESPD_PD_USE_ANALOG0
    bool "Enable espd/ain analog inputs"
    default n

config ESPD_PD_USE_TOUCH0
    bool "Enable espd/touch capacitive inputs"
    default n
    help
        Uses the ESP32 touch sensor on touch-capable GPIOs. Pin list from
        /sdcard/config.txt (touch_pins=) or the defaults below. Not for I2C
        display touch controllers — those need a BSP driver.

config ESPD_PD_INCLUDEPATCH
    bool "Embed test patch at build time"
    default n

config ESPD_SKIP_WIFI_WHEN_MAIN_PD_ON_DISK
    bool "Skip WiFi when main.pd is loaded from local storage"
    default n

config ESPD_ENABLE_LEGACY_WIFI_TRANSPORT
    bool "Run legacy espd TCP/UDP transport tasks"
    default n

config ESPD_AOUT_NUM_CHANNELS
    int "PWM analog output channels (espd/aout/N)"
    default 0
    range 0 4

config ESPD_AOUT_PIN_0
    int "espd/aout/0 GPIO (-1 = disabled)"
    default -1
    range -1 48

config ESPD_AOUT_PIN_1
    int "espd/aout/1 GPIO"
    default -1
    range -1 48

config ESPD_AOUT_PWM_FREQ_HZ
    int "PWM frequency for espd/aout (Hz)"
    default 20000

config ESPD_ANALOG_TASK_PERIOD_MS
    int "Analog input producer task period (ms)"
    default 5
    range 1 500

menu "Capacitive touch (espd/touch)"
    depends on ESPD_PD_USE_TOUCH0

config ESPD_TOUCH_NUM_CHANNELS
    int "Default channel count (when config.txt has no touch_pins=)"
    default 0
    range 0 8
    help
        0 = infer from the highest GPIO slot configured below.

config ESPD_TOUCH_PIN_0
    int "GPIO for espd/touch/0 (-1 = disabled)"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_1
    int "GPIO for espd/touch/1"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_2
    int "GPIO for espd/touch/2"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_3
    int "GPIO for espd/touch/3"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_4
    int "GPIO for espd/touch/4"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_5
    int "GPIO for espd/touch/5"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_6
    int "GPIO for espd/touch/6"
    default -1
    range -1 48

config ESPD_TOUCH_PIN_7
    int "GPIO for espd/touch/7"
    default -1
    range -1 48

config ESPD_TOUCH_TASK_PERIOD_MS
    int "Touch sampling task period (ms)"
    default 5
    range 1 500

config ESPD_TOUCH_REPORT_EVERY_N_BLOCKS
    int "Forward touch updates every N audio blocks"
    default 1
    range 1 64

endmenu

menu "Generic board I2S pins"
    depends on ESPD_BOARD_GENERIC

config ESPD_GENERIC_I2S_BCLK
    int "I2S bit clock GPIO"
    default 13
    range 0 48

config ESPD_GENERIC_I2S_WS
    int "I2S word select GPIO"
    default 33
    range 0 48

config ESPD_GENERIC_I2S_DOUT
    int "I2S data out GPIO"
    default 32
    range 0 48

config ESPD_GENERIC_I2S_DIN
    int "I2S data in GPIO (-1 = unused)"
    default 35
    range -1 48

endmenu

endmenu
