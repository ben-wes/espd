menu "ESPD Configuration"

choice ESPD_BOARD
    prompt "Target board"
    default ESPD_BOARD_GENERIC
    help
        Select the hardware board. Board-specific options are registered by BSP
        components (see menuconfig after selecting a board). Each board may select
        an ESPD feature profile and ship sdkconfig.defaults for IDF tuning.

config ESPD_BOARD_GENERIC
    bool "Generic I2S (manual GPIO pins)"
    imply ESPD_ENABLE_LEGACY_WIFI_TRANSPORT
    help
        Bare I2S pins without an external codec driver. Tune GPIOs under
        "Generic board I2S pins" below. BSP boards add a component under
        components/espd_board_* (see docs/ADDING_A_BOARD.md).

orsource "../components/espd_boards/Kconfig.inc"

endchoice

config ESPD_BOARD_ESP_BSP_GLUE
    bool
    default n
    help
        Internal: compile shared esp-bsp audio/I/O glue in the enabled
        board plugin (espd_bsp_esp_bsp_*.c). Selected automatically for
        boards defined in boards/*.yaml.

menu "Audio (dac~ / adc~)"

config ESPD_IOCHANS
    int "I/O channel count"
    default 2
    range 1 2

config ESPD_AUDIO_SAMPLE_RATE
    int "Default audio sample rate (Hz)"
    default 48000
    range 8000 192000
    help
        Sample rate requested from both the audio backend (I2S / codec) and Pd
        (sys_getsr / dac~ / adc~). Common values: 16000, 22050, 32000, 44100,
        48000, 96000. Override at boot with audio_sample_rate= in config.txt.
        Some BSPs / codecs only support a fixed subset; mismatches surface as
        a codec-open failure or pitched output.

config ESPD_USE_ADC
    bool "Enable adc~ capture"
    default n
    help
        When enabled, espd_audio reads from the board microphone / ADC path.

choice ESPD_AUDIO_BACKEND
    prompt "Backend"
    default ESPD_AUDIO_BACKEND_GENERIC_I2S if ESPD_BOARD_GENERIC
    default ESPD_AUDIO_BACKEND_BSP_CODEC
    help
        Generic I2S drives pins directly. BSP codec uses bsp_audio_* from the
        active BSP package (see bsp/config.h in the linked BSP component).

config ESPD_AUDIO_BACKEND_GENERIC_I2S
    bool "Generic I2S (no codec driver)"
    depends on ESPD_BOARD_GENERIC

config ESPD_AUDIO_BACKEND_BSP_CODEC
    bool "BSP codec (esp_codec_dev via bsp_audio_*)"
    depends on !ESPD_BOARD_GENERIC

config ESPD_AUDIO_BACKEND_DAC
    bool "Internal DAC (GPIO25/26)"
    help
        Uses ESP32 internal DAC channels for audio output. Converts int16 PCM
        to 8-bit DAC output. No capture support (adc~ not available).

endchoice

menu "DAC channel configuration"
    depends on ESPD_AUDIO_BACKEND_DAC

choice ESPD_DAC_CHANNELS
    prompt "DAC channels to use"
    default ESPD_DAC_USE_BOTH_CHANNELS
    help
        Select which DAC channels to use for audio output.
        CH0 = GPIO25, CH1 = GPIO26. Using both channels enables true stereo output.

config ESPD_DAC_USE_BOTH_CHANNELS
    bool "Both channels (stereo, GPIO25+26)"
    help
        Use both DAC channels for true stereo output. Left channel to GPIO25, right channel to GPIO26.

config ESPD_DAC_USE_CH0_ONLY
    bool "CH0 only (mono, GPIO25)"
    help
        Use only DAC channel 0 (GPIO25) for mono output.

config ESPD_DAC_USE_CH1_ONLY
    bool "CH1 only (mono, GPIO26)"
    help
        Use only DAC channel 1 (GPIO26) for mono output.

endchoice

endmenu

endmenu

menu "Storage & patches"

config ESPD_USE_SDCARD
    bool "Enable SD card"
    default n

config ESPD_INCLUDEPATCH
    bool "Embed fallback test patch at build time"
    default n
    help
        Used when no main.pd is found on SD or USB MSC storage at boot.

menu "USB device (OTG)"
    depends on SOC_USB_OTG_SUPPORTED

    config ESPD_USE_USB_CDC
        bool
        depends on ESPD_USE_USB_OTG && TINYUSB_CDC_ENABLED
        help
            Internal: always on when OTG is enabled. Serial on cu.usbmodem* for
            Pd printf/print and ESP_LOG (see docs/DEV_SYNC.md).

    config ESPD_USE_USB_OTG
        bool "Enable TinyUSB device stack on OTG port"
        default n
        help
            USB device on the OTG port (ESP32-S3, ESP32-P4). Enables OTG CDC
            (Pd printf, ESP_LOG on cu.usbmodem*) and, by default, internal-flash
            USB mass storage. Uncheck MSC if you do not want a host-visible data partition.
            Patch sync (espd_sync) is a separate option and needs microSD.
            Requires CONFIG_ESP_CONSOLE_NONE (Waveshare board profile sets this).

            Reflash: BOOT + RESET (download mode), then idf.py flash — not
            cu.debug-console on macOS (esptool often gets no data there). App
            serial is OTG cu.usbmodem* while running. See docs/DEV_SYNC.md.
        select ESPD_USE_USB_CDC

    if ESPD_USE_USB_OTG

        config ESPD_USE_USB_MSC
            bool "USB mass storage (internal flash drive)"
            depends on TINYUSB_MSC_ENABLED
            default y
            help
                Expose the "storage" partition as a USB drive. Slow; shares flash
                with the CPU. Rapid dev uses SD only — uncheck if you do not need
                the drive on the same cable.

        config ESPD_USB_CONSOLE_CDC
            bool
            default ESPD_USE_USB_CDC
            help
                Internal: stdout/printf routing via tinyusb_console_init.

        config ESPD_DEV_CDC_SYNC
            bool "Patch sync over OTG CDC (espd_sync)"
            depends on ESPD_USE_SDCARD || ESPD_USE_USB_MSC
            default y
            help
                PUT/RELOAD/STATUS/RESET on the OTG serial port. Target is /sdcard
                (normal) or /storage (MODE MSC_SYNC). Needs SD and/or internal
                flash MSC enabled. Serial (printf, ESP_LOG) still works when off.

                See docs/DEV_SYNC.md.

    endif

endmenu

endmenu

menu "WiFi & network"
    depends on ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED || ESP_WIFI_REMOTE_ENABLED

config ESPD_USE_WIFI
    bool "Enable WiFi (Pd netsend / netreceive)"
    depends on ESP_WIFI_ENABLED || ESP_HOST_WIFI_ENABLED || ESP_WIFI_REMOTE_ENABLED
    default n
    help
        Native Wi-Fi on ESP32/ESP32-S3 (ESP_WIFI_ENABLED), IDF host Wi-Fi on
        some targets (ESP_HOST_WIFI_ENABLED), or P4 SDIO coprocessor Wi-Fi via
        esp_wifi_remote + esp_hosted (ESP_WIFI_REMOTE_ENABLED). Waveshare P4-NANO
        uses the latter. Runtime: non-empty wifi_ssid= in config.txt.

config ESPD_ENABLE_LEGACY_WIFI_TRANSPORT
    bool "Legacy espd TCP/UDP transport (port 4498)"
    depends on ESPD_USE_WIFI
    default y if ESPD_BOARD_GENERIC
    default n
    help
        Old host-driven patch loading over TCP/UDP. Not needed for Pd
        [netsend] / [netreceive]. Generic I2S profile enables this by default.

endmenu

config ESPD_USE_CONSOLE
    bool "Route Pd print / logs to console"
    default y
    help
        With OTG CDC console enabled, stdout goes to the TinyUSB CDC port.
        Otherwise uses the IDF console (USB-JTAG or UART).

config ESPD_USE_AIN
    bool "Compile espd/ain support (GPIO analog inputs)"
    default n
    help
        Links espd/ain code into the firmware. Sampling starts only when
        config.txt lists GPIOs: ain_pins=3,4 (SD or /storage). No config.txt,
        no ain_pins= key, or empty ain_pins= → espd/ain stays off (same idea
        as wifi_ssid= gating WiFi). Optional tuning: ain_task_period_ms,
        ain_deadband, ain_report_every_n_blocks.

config ESPD_USE_TOUCH
    bool "Compile espd/touch support (capacitive GPIO inputs)"
    default n
    help
        Links ESP32 touch-sensor / espd/touch code into the firmware. Sampling
        starts only when config.txt lists GPIOs: touch_pins=4,5 (SD or /storage).
        No touch_pins= key or empty list → no touch task, no polling (same idea
        as ain_pins= and wifi_ssid=). Optional tuning in config.txt:
        touch_task_period_ms, touch_report_every_n_blocks.

config ESPD_USE_AOUT
    bool "Compile espd/aout support (PWM GPIO outputs)"
    default n
    help
        Links LEDC PWM / espd/aout code into the firmware. Channels start only
        when config.txt lists GPIOs: aout_pins=8,9 (SD or /storage). No
        aout_pins= key or empty list → no LEDC setup. Updates only when the Pd
        patch sends floats (no background polling). Optional in config.txt:
        aout_pwm_freq_hz=20000.

config ESPD_USE_DIN
    bool "Compile espd/din GPIO support (extra digital inputs)"
    default n
    help
        Links GPIO poll task for extra espd/din channels. BSP buttons (if any)
        occupy espd/din/0.. first; config.txt din_pins= appends GPIO channels
        at higher indices. No din_pins= key → no GPIO polling (BSP din still
        works). Optional: din_active_low, din_task_period_ms.

config ESPD_USE_DOUT
    bool "Compile espd/dout support (GPIO digital outputs)"
    default n
    help
        Links GPIO digital out / espd/dout code. Channels start only when
        config.txt lists GPIOs: dout_pins=8,9. Float >= 0.5 → high. No
        dout_pins= key or empty list → no GPIO outputs configured.

menu "Generic board I2S pins"
    depends on ESPD_BOARD_GENERIC

config ESPD_GENERIC_I2S_BCLK
    int "I2S bit clock GPIO"
    default 13
    range 0 48

config ESPD_GENERIC_I2S_WS
    int "I2S word select GPIO"
    default 33
    range 0 48

config ESPD_GENERIC_I2S_DOUT
    int "I2S data out GPIO"
    default 32
    range 0 48

config ESPD_GENERIC_I2S_DIN
    int "I2S data in GPIO (-1 = unused)"
    default 35
    range -1 48

endmenu

endmenu
