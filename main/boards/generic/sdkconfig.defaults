# Generic I2S board profile (merged when CONFIG_ESPD_BOARD_GENERIC=y).
# Minimal ESPD defaults; IDF target/flash/PSRAM come from the root sdkconfig.

CONFIG_ESPD_BOARD_GENERIC=y
CONFIG_ESPD_USE_ADC=n
CONFIG_ESPD_PD_USE_SDCARD=n
CONFIG_ESPD_PD_USE_ANALOG0=n
CONFIG_ESPD_PD_INCLUDEPATCH=n
CONFIG_ESPD_SKIP_WIFI_WHEN_MAIN_PD_ON_DISK=n
CONFIG_ESPD_ENABLE_LEGACY_WIFI_TRANSPORT=y

CONFIG_ESPD_AOUT_NUM_CHANNELS=0
CONFIG_ESPD_AOUT_PIN_0=-1
CONFIG_ESPD_AOUT_PIN_1=-1
CONFIG_ESPD_AOUT_PWM_FREQ_HZ=20000
CONFIG_ESPD_ANALOG_TASK_PERIOD_MS=5
