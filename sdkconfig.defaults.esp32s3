# ESP32-S3 target defaults for this project (reference kit: Waveshare ESP32-S3-AUDIO).
# IDF merges this automatically on idf.py set-target esp32s3. Board profile
# tuning lives in components/espd_bsp_selector/sdkconfig.defaults.

CONFIG_ESPD_BOARD_WAVESHARE_S3=y
CONFIG_ESPD_USE_ADC=y
CONFIG_ESPD_PD_USE_SDCARD=y
CONFIG_ESPD_PD_USE_ANALOG0=y
CONFIG_ESPD_PD_INCLUDEPATCH=y
CONFIG_ESPD_SKIP_WIFI_WHEN_MAIN_PD_ON_DISK=y
CONFIG_ESPD_ENABLE_LEGACY_WIFI_TRANSPORT=n
CONFIG_ESPD_PD_USE_AOUT=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Octal PSRAM — required for FFT-sized Pd patches.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP32S3_REV_MIN_2=y
CONFIG_ESP32S3_REV_MIN_FULL=2
CONFIG_ESP_REV_MIN_FULL=2

CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_CORE_DEFAULT=0

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=0

CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3

CONFIG_LWIP_IPV6=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# Audio (app_main) on CPU1; network on CPU0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY=0x1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY=0x0
CONFIG_ESP_TIMER_TASK_AFFINITY=0x0
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_MAX_SOCKETS=8

CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y

CONFIG_FREERTOS_IN_IRAM=y
