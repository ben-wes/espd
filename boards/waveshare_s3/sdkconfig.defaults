# Waveshare ESP32-S3-AUDIO-Board (ESP32-S3R8, 8MB Octal PSRAM, 16MB flash)
# Apply after: idf.py set-target esp32s3
# See boards/waveshare_s3/README.txt

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Same custom table as LyraT / WROOM builds (see partitions_pd.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# TinyUSB device shares the internal USB PHY with USB-Serial-JTAG; use UART for log.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# TinyUSB is optional; keep off unless ESPD_WAVESHARE_USB_BOOT_TINYUSB_PROBE is enabled.
# CONFIG_TINYUSB_CDC_ENABLED is not set

# Performance profile (runtime DSP-focused):
# - prefer speed-oriented compiler optimization
# - keep checks/asserts quiet
# - keep default logs at INFO for UART debugging
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
