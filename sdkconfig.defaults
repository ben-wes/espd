# Project-wide defaults (all targets). Board choice and profile defaults are
# merged in CMakeLists.txt; target tuning in sdkconfig.defaults.<target>.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Do not fsync after every FatFs write (IDF default off); espd_dev fsyncs MSC PUTs.
CONFIG_FATFS_IMMEDIATE_FSYNC=n
