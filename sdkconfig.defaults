# Project-wide defaults (all targets). Board choice and profile defaults are
# merged in CMakeLists.txt; target tuning in sdkconfig.defaults.<target>.

# Board-agnostic storage: the base table has no storage partition; at boot espd
# detects the TRUE physical flash size (esp_flash_get_physical_size) and registers
# a full-flash FAT "storage" spanning the remainder (espd_usb_register_dynamic_storage),
# so one firmware fits any chip independent of the flashing tool. The FLASHSIZE
# below is only a build-time placeholder for the app-size-fits check.
# HEADER_FLASHSIZE_UPDATE patches the header at flash time when the tool honors it
# (esptool.py) — a nicety for esptool's own size reporting, not relied upon at runtime.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_pd.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Do not fsync after every FatFs write (IDF default off); espd_dev fsyncs MSC PUTs.
CONFIG_FATFS_IMMEDIATE_FSYNC=n
CONFIG_FATFS_USE_LABEL=y

# Compiler optimizations for performance
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=0
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y


# Default logging levels (Info)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3

# IRAM Optimizations
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_I2C_ISR_IRAM_SAFE=y
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_I2S_CTRL_FUNC_IN_IRAM=y
CONFIG_UART_ISR_IN_IRAM=y

# Lightweight networking & TLS
CONFIG_LWIP_IPV6=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
