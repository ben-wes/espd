# ESP32 (classic) — conservative defaults for typical 4 MB dev boards (~320 KB RAM).
# Chip files are IDF tuning only; board choice is the Kconfig "ESPD_BOARD" choice
# (defaults to generic, override in menuconfig or sdkconfig.defaults.local).
# Flash size is detected at flash time; /storage is registered at runtime.

# Pd on app_main; IDF default 3584 overflows on FFT-heavy patches. 32 KiB fits
# typical patches on tight internal RAM; use 65536 for FFT-heavy work if headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Audio loop on CPU1; WiFi/pthread workers on CPU0 (see main/espd.c, espd_dev.c).
# Crucial on dual-core ESP32 to prevent Wi-Fi/IP interrupts from glitching real-time audio.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY="0x1"
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_CORE_DEFAULT=0

# CPU Frequency (240 MHz for maximum DSP capability)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Networking limits
CONFIG_LWIP_MAX_SOCKETS=8

# WiFi memory: classic ESP32 has no PSRAM and only ~250 KB usable internal RAM,
# yet without this it would run the *larger* IDF-default WiFi buffers (bigger than
# the S3's). Trim them so WiFi + legacy net + Pd + audio fit (lower WiFi throughput
# is fine for control traffic / dev fallback; it avoids the out-of-memory panic
# seen booting the generic-DAC firmware with no patch loaded).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# Classic ESP32 does not support hardware DS (Digital Signature) or HMAC peripherals
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n
CONFIG_MBEDTLS_HARDWARE_RSA_DS_PERIPHERAL=n

# DAC functions in IRAM
CONFIG_DAC_CTRL_FUNC_IN_IRAM=y
CONFIG_DAC_ISR_IRAM_SAFE=y

# serial sync default
CONFIG_ESPD_DEV_SYNC=y
CONFIG_ESPD_DEV_SERIAL_SYNC=y
