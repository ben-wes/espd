choice ESPD_BOARD
    config ESPD_BOARD_WAVESHARE_S3
        bool "Waveshare ESP32-S3-AUDIO"
        imply ESPD_USE_ADC
        imply ESPD_PD_USE_SDCARD
        imply ESPD_PD_USE_ANALOG0
        imply ESPD_PD_INCLUDEPATCH
        imply ESPD_SKIP_WIFI_WHEN_MAIN_PD_ON_DISK
        help
            Waveshare AI Smart Speaker / ESP32-S3-AUDIO-Board (ES8311 DAC,
            ES7210 mic). Select in menuconfig; **ESPD_BSP_COMPONENT_NAME** links
            the BSP automatically (see components/bsp_waveshare_s3/README.txt).

endchoice

config ESPD_BSP_COMPONENT_NAME
    default "bsp_waveshare_s3" if ESPD_BOARD_WAVESHARE_S3

menu "Board Support Package (Waveshare S3)"
    depends on ESPD_BOARD_WAVESHARE_S3

config BSP_WAVESHARE_ENABLE_MIC
    bool "Enable ES7210 microphone capture"
    default y if ESPD_USE_ADC
    default n
    help
        When enabled, bsp_audio_init() also brings up the ES7210 ADC for adc~ input.

config BSP_WAVESHARE_EXIO7_USB_ROUTE_LEVEL
    int "EXIO7 USB route level (Type-C D+/D- to SoC USB)"
    default 1
    range 0 1

config BSP_WAVESHARE_EXIO6_CAMERA_SEL_LEVEL
    int "EXIO6 camera select level on USB switch"
    default 0
    range 0 1

config BSP_WAVESHARE_PA_PORT1_MASK
    hex "TCA9555 port1 PA enable bit mask (EXIO8..15)"
    default 0x03

config BSP_WAVESHARE_PA_PORT1_ACTIVE_HIGH
    bool "PA port1 bits are active-high"
    default y

endmenu
