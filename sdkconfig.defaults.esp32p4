# ESP32-P4 — chip-wide tuning only (no board pre-select; pick board in menuconfig
# or sdkconfig.defaults.local). Flash size is detected at flash time; /storage
# is registered at runtime for whatever the chip has.

CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Audio loop on CPU1; USB/WiFi/pthread workers on CPU0 (see main/espd.c, espd_dev.c).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY="0x1"
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_CORE_DEFAULT=0

# Wear levelling + TinyUSB MSC (when enabled): 4 KiB sectors, bufsize >= sector.
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# HP CPU frequency (360 MHz — typical for ESP32-P4-NANO class boards)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Networking limits
CONFIG_LWIP_MAX_SOCKETS=8

# ESP-Hosted / esp_wifi_remote (C6 coprocessor Wi-Fi on P4 boards)
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=8
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_WIFI_RMT_RX_BA_WIN=16

# PSRAM (32 MB stacked on ESP32-P4-NANO class boards)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

# Dev sync + monitor on USB Serial/JTAG (no OTG by default)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPD_USE_USB_OTG=n
CONFIG_ESPD_DEV_SYNC=y
