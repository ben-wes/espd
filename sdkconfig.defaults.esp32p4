# ESP32-P4 — chip-wide tuning only (no board pre-select; pick board in menuconfig
# or sdkconfig.defaults.local). Board profile: components/espd_board_*/sdkconfig.defaults.

CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Audio loop on CPU1; Wi-Fi/pthread workers on CPU0 (see main/espd.c, espd_dev.c).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY="0x1"
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_CORE_DEFAULT=0

# TinyUSB MIDI device class (1 interface) — compiles tud_midi_*; ESPD_USE_USB_MIDI
# decides whether the MIDI interface is exposed.
CONFIG_TINYUSB_MIDI_COUNT=1

# Networking (esp_wifi_remote on P4; smaller socket pool than S3 native Wi-Fi).
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SACK_OUT=y

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100

CONFIG_ESP32P4_REV_MAX_FULL=199
CONFIG_ESP_REV_MAX_FULL=199
CONFIG_ESP_EFUSE_BLOCK_REV_MIN_FULL=0
CONFIG_ESP_EFUSE_BLOCK_REV_MAX_FULL=199
