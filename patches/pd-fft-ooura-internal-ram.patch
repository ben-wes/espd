+#if defined(ESP_PLATFORM)
+#include "esp_heap_caps.h"
+/* Ooura's working set is touched every sample of rdft(); keep it in internal
+ * SRAM even when generic getbytes() routes large blocks to PSRAM. */
+static void *ooura_getbytes(size_t nbytes)
+{
+    void *p = heap_caps_calloc(1, nbytes, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+    if (!p)
+        p = t_getbytes(nbytes);
+    return p;
+}
+static void ooura_freebytes(void *p, size_t nbytes)
+{
+    (void)nbytes;
+    if (p)
+        free(p);
+}
+#else
+#define ooura_getbytes(n) t_getbytes(n)
+#define ooura_freebytes(p, n) t_freebytes(p, n)
+#endif
+
