+static int socket_errno_udp_send_ok(void)
+{
+    int err = socket_errno();
+#ifdef _WIN32
+    return (err == WSAEWOULDBLOCK || err == WSAENOBUFS);
+#else
+    return (err == EAGAIN || err == EWOULDBLOCK || err == ENOBUFS || err == ENOMEM);
+#endif
+}
